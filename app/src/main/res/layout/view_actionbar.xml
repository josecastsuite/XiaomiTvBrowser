<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">
  <ImageButton
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center_vertical"
      android:id="@+id/ibTopBack"
      android:src="@drawable/back_icon_selector"
      android:scaleType="fitCenter"
      android:padding="4dp"
      android:nextFocusRight="@+id/ibTopForward"
      android:nextFocusDown="@+id/vTabs"
      android:background="@drawable/button_bg_selector"
      android:layout_margin="5dp"
      android:focusable="true"
      android:focusableInTouchMode="true"
      android:contentDescription="@string/navigate_back" />

  <ImageButton
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center_vertical"
      android:id="@+id/ibTopForward"
      android:src="@drawable/forward_icon_selector"
      android:scaleType="fitCenter"
      android:padding="4dp"
      android:nextFocusRight="@+id/ibTopRefresh"
      android:nextFocusDown="@+id/vTabs"
      android:background="@drawable/button_bg_selector"
      android:layout_margin="5dp"
      android:contentDescription="@string/navigate_forward" />

  <ImageButton
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center_vertical"
      android:id="@+id/ibTopRefresh"
      android:src="@drawable/ic_refresh_grey_900_24dp"
      android:scaleType="fitCenter"
      android:padding="4dp"
      android:nextFocusRight="@+id/flUrl"
      android:nextFocusDown="@+id/vTabs"
      android:background="@drawable/button_bg_selector"
      android:layout_margin="5dp"
      android:contentDescription="@string/refresh_page" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="36dp"
      android:layout_gravity="center_vertical"
      android:layout_alignWithParentIfMissing="true"
      android:layout_marginStart="8dp"
      android:layout_marginEnd="8dp"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="12dp"
      android:paddingEnd="8dp"
      android:background="@drawable/bg_omnibox"
      android:id="@+id/flUrl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="12sp"
        android:importantForAccessibility="no" />

    <EditText
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:id="@+id/etUrl"
        android:iconifiedByDefault="false"
        android:textCursorDrawable="@null"
        android:textColor="@color/default_url_color"
        android:background="@null"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:imeOptions="actionSearch"
        android:hint="@string/url_prompt"
        android:inputType="textFilter|textNoSuggestions|textUri"
        android:importantForAutofill="no" />

    <ImageButton
        android:id="@+id/ibFavorites"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:scaleType="fitCenter"
        android:padding="2dp"
        android:src="@drawable/ic_star_border_grey_900_36dp"
        android:background="@drawable/button_bg_selector"
        android:nextFocusRight="@+id/ibOverflowMenu"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/favorites" />
  </LinearLayout>

  <ImageButton
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center_vertical"
      android:id="@+id/ibOverflowMenu"
      android:src="@drawable/ic_more_vert"
      android:scaleType="fitCenter"
      android:padding="2dp"
      android:focusable="true"
      android:nextFocusDown="@+id/vTabs"
      android:background="@drawable/button_bg_selector"
      android:layout_margin="5dp"
      android:contentDescription="@string/toggle_main_menu" />
</merge>
